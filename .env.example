# Ollama models the server runs, as `ollama list` names them.
LAZY_DUNMAS_MODEL=
LAZY_DUNMAS_EMBED_MODEL=

# The prefixes the embedding model's card asks for, if any, quoted to keep
# trailing spaces. Leave them empty for a model that takes none.
LAZY_DUNMAS_QUERY_PREFIX=""
LAZY_DUNMAS_DOCUMENT_PREFIX=""
